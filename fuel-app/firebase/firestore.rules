rules_version = '2';
// Security rules for the EZ Staff app (EZ Storage): fuel bills and claims, attendance, overtime, payroll.
// Roles: driver (staff) < supervisor (verifies) < manager (approves, pays) < admin (also allows people, sets roles).
// New accounts wait until the admin allows them. Nobody can verify or approve their own claim.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function active() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && me().active == true; }
    function role() { return me().role; }
    function isAdmin() { return active() && role() == 'admin'; }
    function isOffice() { return active() && role() in ['supervisor', 'manager', 'admin']; }
    function canApprove() { return active() && role() in ['manager', 'admin']; }
    function mine(data) { return active() && data.ownerUid == request.auth.uid; }
    function changes() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function num(v) { return v is int || v is float; }
    function was(s) { return resource.data.status == s; }
    function now(s) { return request.resource.data.status == s; }
    function fuelAllowed() { return me().get('fuel', true) != false; }

    // ---- people ----
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isOffice());
      // new accounts start as a driver waiting for the admin to allow them
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.role == 'driver' && request.resource.data.active == false && request.resource.data.pending == true;
      // people edit their own details, never their role or whether they are allowed
      allow update: if (signedIn() && request.auth.uid == uid && !changes().hasAny(['role', 'active', 'pending', 'fuel', 'email', 'allowedAt', 'allowedBy'])) || isAdmin();
      allow delete: if isAdmin();
    }

    // ---- fuel bills ----
    match /bills/{id} {
      allow read: if mine(resource.data) || isOffice();
      allow create: if mine(request.resource.data) && fuelAllowed() && request.resource.data.claimId == null
        && request.resource.data.date is string && num(request.resource.data.odometer)
        && num(request.resource.data.litres) && request.resource.data.litres > 0
        && num(request.resource.data.amount) && request.resource.data.amount > 0;
      // the owner edits a bill only until it is claimed; after that only its claim link can change
      allow update: if mine(resource.data) && request.resource.data.ownerUid == request.auth.uid
        && (resource.data.claimId == null || changes().hasOnly(['claimId', 'updatedAt']));
      allow delete: if (mine(resource.data) && resource.data.claimId == null) || isAdmin();
    }

    // ---- claims ----
    match /claims/{id} {
      allow read: if mine(resource.data) || isOffice();
      allow create: if mine(request.resource.data) && fuelAllowed() && request.resource.data.status == 'submitted'
        && !request.resource.data.keys().hasAny(['verifiedAt', 'approvedAt', 'paidAt', 'paidAmount', 'paidRef', 'paidBy']);

      // office decisions; never on your own claim, and the bills inside a claim never change
      function notOwn() { return resource.data.ownerUid != request.auth.uid; }
      function billsKept() { return !changes().hasAny(['ownerUid', 'receipts', 'billIds', 'totals', 'driverSignature', 'mileage', 'claimNo']); }
      function supervisorStep() {
        return was('submitted') && (now('verified') || now('returned'))
          && changes().hasOnly(['status', 'verifiedBy', 'verifiedByUid', 'verifiedAt', 'remarks', 'history', 'updatedAt']);
      }
      function managerStep() {
        return ((was('submitted') || was('verified')) && (now('verified') || now('approved') || now('returned') || now('rejected')))
          || (was('approved') && now('paid'))
          || (was('paid') && now('approved'));
      }
      allow update: if isOffice() && notOwn() && billsKept()
        && ((role() == 'supervisor' && supervisorStep()) || (canApprove() && managerStep()) || isAdmin());

      // the owner can withdraw a claim before anyone checks it, or after it was returned; its bills go back to the list
      allow delete: if (mine(resource.data) && resource.data.status in ['submitted', 'returned']) || isAdmin();
    }

    // ---- bill photos ----
    match /photos/{id} {
      allow read: if mine(resource.data) || isOffice();
      allow create: if mine(request.resource.data) && request.resource.data.data is string
        && request.resource.data.data.size() < 1000000;
      allow delete: if mine(resource.data) || isAdmin();
    }

    // ---- company settings: warehouses, shifts, overtime rules, holidays ----
    match /settings/{doc} {
      allow read: if active();
      allow write: if isAdmin();
    }

    // ---- salaries: only the admin can see and set them ----
    match /pay/{uid} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // ---- attendance: one entry per stay at a warehouse ----
    match /attendance/{id} {
      function ms(v) { return v is int || v is float; }
      // the tap time must match Google's clock (up to 12 hours late when the phone had no signal)
      function freshIn() {
        return request.resource.data.inServer == request.time && ms(request.resource.data.inAt)
          && request.resource.data.inAt <= request.time.toMillis() + 300000
          && request.resource.data.inAt >= request.time.toMillis() - 43200000;
      }
      function freshOut() {
        return request.resource.data.outServer == request.time && ms(request.resource.data.outAt)
          && request.resource.data.outAt <= request.time.toMillis() + 300000
          && request.resource.data.outAt >= request.time.toMillis() - 43200000
          && request.resource.data.outAt > resource.data.inAt;
      }
      allow read: if mine(resource.data) || isOffice();
      // staff clock themselves in; supervisors add entries for others (never for themselves)
      allow create: if (mine(request.resource.data) && request.resource.data.source == 'self'
                        && request.resource.data.outAt == null && freshIn())
        || (isOffice() && request.resource.data.ownerUid != request.auth.uid && request.resource.data.source == 'supervisor');
      // staff can only clock out of their own open entry (possibly at another warehouse); supervisors can correct other people's entries
      allow update: if (mine(resource.data) && resource.data.source == 'self' && resource.data.outAt == null
                        && changes().hasOnly(['outAt', 'outServer', 'outLoc', 'outWarehouse', 'updatedAt']) && freshOut())
        || (isOffice() && resource.data.ownerUid != request.auth.uid && request.resource.data.ownerUid == resource.data.ownerUid);
      allow delete: if isOffice() && resource.data.ownerUid != request.auth.uid;
    }

    // ---- overtime per person per day ({uid}_{date}) ----
    match /ot/{id} {
      allow read: if mine(resource.data) || isOffice();
      // staff record their own overtime as waiting; they can't approve it or change a decision
      allow create: if (mine(request.resource.data) && id == request.auth.uid + '_' + request.resource.data.date
                        && request.resource.data.status == 'pending' && !request.resource.data.keys().hasAny(['approvedMin', 'decidedBy', 'decidedByUid', 'decidedAt']))
        || (isOffice() && request.resource.data.ownerUid != request.auth.uid);
      allow update: if (mine(resource.data) && resource.data.status == 'pending' && request.resource.data.status == 'pending'
                        && request.resource.data.ownerUid == request.auth.uid
                        && !request.resource.data.keys().hasAny(['approvedMin', 'decidedBy', 'decidedByUid', 'decidedAt']))
        || (isOffice() && resource.data.ownerUid != request.auth.uid && request.resource.data.ownerUid == resource.data.ownerUid);
      allow delete: if isAdmin();
    }

    // ---- claim numbers ----
    match /counters/{uid} {
      allow read, write: if active() && request.auth.uid == uid;
    }
  }
}
