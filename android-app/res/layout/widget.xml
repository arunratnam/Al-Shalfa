<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F012161B"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/w_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/widget_title"
            android:textColor="#FFE8EBEF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/w_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FF8A939E"
            android:textSize="12sp"
            android:paddingRight="8dp" />

        <TextView
            android:id="@+id/w_add"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:gravity="center"
            android:text="+"
            android:textColor="#FF001A2B"
            android:textSize="22sp"
            android:textStyle="bold"
            android:background="#FF6CC4FF" />
    </LinearLayout>

    <ListView
        android:id="@+id/w_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingTop="6dp"
        android:divider="@null"
        android:dividerHeight="0dp" />

    <TextView
        android:id="@+id/w_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="@string/widget_empty"
        android:textColor="#FF8A939E"
        android:textSize="14sp" />
</LinearLayout>
